      "item": [
        {
          "name": "Channel3 Search Retail Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/channel3/search?query=cheese&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channel3", "search"],
              "query": [
                { "key": "query", "value": "cheese" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Channel3 MCP Tools Manifest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/channel3/tools",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channel3", "tools"]
            }
          }
        },
        {
          "name": "Channel3 MCP JSON-RPC tools/list",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/channel3/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channel3", "mcp"]
            }
          }
        }
      ]
    },
    {
      "name": "3. A2A Bilateral Bargaining",
      "item": [
        {
          "name": "Dispatch A2A Counter-Offer Packet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"consumer_agent\",\n  \"type\": \"counter_offer\",\n  \"storeId\": \"woolworths-food\",\n  \"itemName\": \"Artisan Sourdough & Cheese Platter\",\n  \"price\": 175,\n  \"originalPrice\": 220,\n  \"agentRationale\": \"Proposing R175 based on midday clearance velocity and customer budget cap.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agent/negotiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agent", "negotiate"]
            }
          }
        }
      ]
    },
    {
      "name": "4. PayPal AI Agent Orders & Vaulted Settlement",
      "item": [
        {
          "name": "Create PayPal Sandbox Order (ZAR -> USD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"woolworths-food\",\n  \"negotiatedPriceZAR\": 175,\n  \"originalPriceZAR\": 220,\n  \"sku\": \"WW-GOURMET-CHEESE-01\",\n  \"vaultedAgentConsent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/paypal/create-order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "paypal", "create-order"]
            }
          }
        },
        {
          "name": "Execute Vaulted Machine-to-Machine Capture",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"vaultRef\": \"VAULT_AUTONOMOUS_DELEGATE_771B\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/paypal/checkout-settle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "paypal", "checkout-settle"]
